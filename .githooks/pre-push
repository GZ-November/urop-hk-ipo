#!/bin/bash
# pre-push: 与 CI 共用 lint、流水线/分析测试、registry 一致性检查。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: 运行代码质量与回归检查..."
log=$(mktemp)
trap 'rm -f "$log"' EXIT
# 直接判断 unittest 自身的退出码；经管道会变成 tail 的退出码，从而永远放行
if ! make check-code >"$log" 2>&1; then
    tail -20 "$log"
    echo ""
    echo "❌ 检查失败，推送已阻止。完整日志摘要见上方。"
    exit 1
fi
tail -3 "$log"
echo "✅ 代码质量与回归检查通过，允许推送"
